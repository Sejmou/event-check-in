# Drizzle
DATABASE_URL=local.db

# Public origin: scheme, host and port only, never a path (see BASE_PATH). The QR
# code on the check-in screen points here, so it must be reachable from attendees'
# phones — and HTTPS, or organizer passkeys will not
# work. Its hostname is the passkey relying party, so changing it voids them.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Only when the app is served under a sub-path, e.g. /check-in (leading slash, no
# trailing one). ORIGIN stays scheme and host without it. Applied at build time.
# BASE_PATH=/check-in

# Docker only: the host port compose publishes the app on.
# HOST_PORT=3000
