# Drizzle
DATABASE_URL=local.db

# Public base URL. The QR code on the check-in screen points here, so it must be
# reachable from attendees' phones — and HTTPS, or passkeys will not work. Its
# hostname is the passkey relying party, so changing it voids every passkey.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
